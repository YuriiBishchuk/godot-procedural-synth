<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>GodotProceduralSynth</PackageId>
    <Version>1.0.0</Version>
    <Authors>Yurii Bishchuk</Authors>
    <Description>Universal real-time procedural audio and music synthesis engine for Godot 4 (C# / .NET) with dynamic adaptive arrangement and SFX generation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/YuriiBishchuk/godot-procedural-synth</PackageProjectUrl>
    <RepositoryUrl>https://github.com/YuriiBishchuk/godot-procedural-synth</RepositoryUrl>
    <PackageTags>godot;godot4;godot-engine;csharp;procedural-audio;synth;audiostreamgenerator;dsp;sfx;game-audio;dynamic-music;adaptive-music;sound-effects;shchedryk;ukraine</PackageTags>
  </PropertyGroup>

</Project>
