<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>GodotProceduralSynth</PackageId>
    <Version>1.0.0</Version>
    <Authors>Yurii Bishchuk</Authors>
    <Description>Pure real-time procedural audio synthesis engine for Godot 4 (C# / .NET) with dynamic adaptive arrangement and Cyber-Shchedryk motifs.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/YuriiBishchuk/godot-procedural-synth</RepositoryUrl>
  </PropertyGroup>

</Project>
